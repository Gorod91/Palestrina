rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo chi ha fatto l'accesso a Palestrina (permesso dato dal nostro server).
    function pal() {
      return request.auth != null && request.auth.token.pal == true;
    }
    // Giorno "aaaa-mm-gg" tra ieri e la prossima settimana (il controllo preciso lo fa il server).
    function dayOk(d) {
      let p = d.split('-');
      let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && t > request.time - duration.value(2, 'd')
        && t < request.time + duration.value(8, 'd');
    }

    // Stato dell'app di ognuno (lo scrive il server): lo legge solo lui
    match /{coll}/{uid} {
      allow read: if pal() && coll in ['stato', 'prova_stato'] && request.auth.uid == uid;
    }

    // Azioni in coda per il server: solo a proprio nome, solo nuove; l'esito lo scrive il server
    match /{coll}/{id} {
      allow read: if pal() && coll in ['azioni', 'prova_azioni'] && resource.data.name == request.auth.token.name;
      allow create: if pal()
        && coll in ['azioni', 'prova_azioni']
        && request.resource.data.keys().hasOnly(['name', 'action', 'data', 'stato', 'at'])
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.stato == 'nuova'
        && request.resource.data.action in ['checkin', 'checkinUndo', 'sudometro', 'setReference', 'setAlias', 'setTimer', 'chatMute', 'subscribe', 'sfida', 'state']
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 20000
        && request.resource.data.at == request.time;
    }

    // Foto del Sudometro: le vede chi ha fatto l'accesso; ognuno carica solo le proprie, che poi non cambiano
    match /foto/{id} {
      allow read: if pal();
      allow create: if pal()
        && request.resource.data.keys().hasOnly(['name', 'label', 'mime', 'data', 'at'])
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.mime == 'image/jpeg'
        && request.resource.data.label is string
        && request.resource.data.data is bytes
        && request.resource.data.data.size() < 900000
        && request.resource.data.at == request.time;
    }

    // Si legge tutto; si scrive solo a proprio nome. Eventi, cancellazioni e stato li fa il server.
    match /{coll}/{id} {
      allow read: if pal()
        && coll in ['chat', 'prova_chat', 'state', 'prova_state', 'domande', 'prova_domande', 'piani', 'prova_piani'];

      // Messaggi: solo nuovi
      allow create: if pal()
        && coll in ['chat', 'prova_chat']
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.at == request.time;

      // "Chiedi a tutti": una domanda per giorno (id del documento = giorno), chi arriva secondo non la sovrascrive
      allow create: if pal()
        && coll in ['domande', 'prova_domande']
        && request.resource.data.keys().hasOnly(['day', 'name', 'id', 'at'])
        && id == request.resource.data.day
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.id is string
        && request.resource.data.id.matches('^[a-z0-9]{8,20}$')
        && request.resource.data.at == request.time
        && dayOk(request.resource.data.day);

      // Risposte: la propria (id = giorno_uid), solo se per quel giorno qualcuno ha chiesto
      allow create, update: if pal()
        && coll in ['piani', 'prova_piani']
        && request.resource.data.keys().hasOnly(['day', 'name', 'choice', 'time', 'at'])
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.choice in ['si', 'forse', 'no', '']
        && request.resource.data.time is string
        && (request.resource.data.time == '' || request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.at == request.time
        && dayOk(request.resource.data.day)
        && exists(/databases/$(database)/documents/$(coll == 'piani' ? 'domande' : 'prova_domande')/$(request.resource.data.day));
    }
  }
}
